	}
	cell_fall(scalar) {
          values("0.35818");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.20916");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("0.18467");
	}
      }
    }
