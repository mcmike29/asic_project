      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00153,  0.00471,  0.01445,  0.04434,  0.13605,  0.41749");
          values("0.75852,0.76219,0.77152,0.79640,0.87006,1.09625,1.78896");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00153,  0.00471,  0.01445,  0.04434,  0.13605,  0.41749");
          values("0.01214,0.01557,0.02594,0.05940,0.16636,0.49659,1.50936");
